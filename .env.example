# LLM provider API keys (for data generation)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace (for uploading datasets + loading gated models)
HF_TOKEN=your_huggingface_token_here

# HuggingFace repo names (edit to match your account)
HF_CPT_DATASET_REPO=yourname/pintora-instruct
HF_IFT_DATASET_REPO=yourname/pintora-edit-instruct
HF_MODEL_REPO=yourname/pintora-coder-7b

# Base model to fine-tune
BASE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# Output directories
CPT_OUTPUT_DIR=outputs/cpt-checkpoint
IFT_OUTPUT_DIR=outputs/ift-checkpoint
RL_OUTPUT_DIR=outputs/rl-checkpoint
